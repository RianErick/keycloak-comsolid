{
  "info": {
    "name": "Keycloak Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login (Client Credentials)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "backend-client",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "",
              "type": "text"
            },
            {
              "key": "scope",
              "value": "openid",
              "type": "text"
            }
          ]
        },
        "url": "http://localhost:8080/realms/demo/protocol/openid-connect/token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "pm.expect(json.access_token).to.be.a('string').and.not.empty;",
              "pm.collectionVariables.set('access_token', json.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login (Password Credentials)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "password",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "backend-client",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "",
              "type": "text"
            },
            {
              "key": "username",
              "value": "",
              "type": "text"
            },
            {
              "key": "password",
              "value": "",
              "type": "text"
            },
            {
              "key": "totp",
              "value": "",
              "type": "text"
            },
            {
              "key": "scope",
              "value": "openid",
              "type": "text"
            }
          ]
        },
        "url": "http://localhost:8080/realms/demo/protocol/openid-connect/token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "pm.expect(json.access_token).to.be.a('string').and.not.empty;",
              "pm.collectionVariables.set('access_token', json.access_token);"
            ]
          }
        }
      ]
    }
  ]
}
