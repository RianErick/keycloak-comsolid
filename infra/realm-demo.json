{
  "id": "demo",
  "realm": "demo",
  "displayName": "Demo Keycloak",
  "displayNameHtml": "<strong>Demo Keycloak</strong>",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": true,
  "bruteForceProtected": false,
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR", "en"],
  "defaultLocale": "pt-BR",
  "loginTheme": "keycloak.v2",
  "accessTokenLifespan": 300,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    },
    {
      "alias": "UPDATE_EMAIL",
      "name": "Update Email",
      "providerId": "UPDATE_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 70,
      "config": {
        "verifyEmail": "true"
      }
    }
  ],
  "smtpServer": {
    "allowutf8": "",
    "debug": "false",
    "replyToDisplayName": "",
    "starttls": "false",
    "auth": "",
    "writeTimeout": "10000",
    "envelopeFrom": "",
    "ssl": "false",
    "timeout": "10000",
    "port": "1025",
    "host": "mailhog",
    "replyTo": "",
    "from": "no-reply@demo.local",
    "fromDisplayName": "Keycloak Demo",
    "connectionTimeout": "10000"
  },
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Usuário autenticado"
      },
      {
        "name": "admin",
        "description": "Administrador da aplicação"
      },
      {
        "name": "default-roles-demo",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "user"],
          "client": {
            "account": ["view-profile", "manage-account"]
          }
        },
        "clientRole": false
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-demo",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "backend-client",
      "name": "Backend Service Account",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "frontend-client",
      "name": "Frontend React",
      "description": "React SPA using Authorization Code with PKCE",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:5173",
      "baseUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*",
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "basic"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-backend-client",
      "enabled": true,
      "serviceAccountClientId": "backend-client",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users"]
      }
    }
  ]
}
